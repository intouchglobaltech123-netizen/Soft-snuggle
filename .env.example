# ── Database ───────────────────────────────────────────────
# Leave empty to use the built-in embedded Postgres (PGlite, stored in ./.data).
# For production set a real PostgreSQL connection string (Neon / Supabase / your server).
# Tables are created and products seeded automatically on first start.
# DATABASE_URL=postgres://user:password@host:5432/softsnuggle?sslmode=require
#
# Railway: on the app service set DATABASE_URL = ${{Postgres.DATABASE_URL}}
# (private network, no SSL needed). To reach that database from your own
# computer use the Postgres service's DATABASE_PUBLIC_URL instead, ending in
# ?sslmode=no-verify — Railway's certificate is self-signed, so
# sslmode=require is refused.
DATABASE_URL=

# ── Orders ─────────────────────────────────────────────────
# Owner's WhatsApp number with country code, digits only (91 = India)
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# Business (merchant) UPI ID and the payee name shown to customers
UPI_ID=softsnuggle@okaxis
UPI_PAYEE_NAME=Soft Snuggle

# Shipping rules (₹)
NEXT_PUBLIC_SHIPPING_FLAT=79
NEXT_PUBLIC_FREE_SHIPPING_ABOVE=1499

# ── Accounts ───────────────────────────────────────────────
# Signs the login cookie. Set a long random value in production:
# running `openssl rand -base64 32` gives a good one.
# Changing it logs everyone out, which is the quickest way to end all sessions.
SESSION_SECRET=

# ── Admin panel (/admin) ───────────────────────────────────
# Google accounts allowed in, comma separated. Removing one locks it out at once.
ADMIN_EMAILS=softsnuggle2026@gmail.com

# "Sign in with Google": Google Cloud Console → APIs & Services → Credentials →
# Create OAuth client ID → Web application. Authorised redirect URIs:
#   https://<your site>/api/admin/auth/google/callback
#   http://localhost:3000/api/admin/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The address people visit, used for sign-in redirects. Only needed once a
# custom domain is added; otherwise it is worked out from the request.
# SITE_URL=https://softsnuggle.in
