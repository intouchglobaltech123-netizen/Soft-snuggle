# ── Database ───────────────────────────────────────────────
# Leave empty to use the built-in embedded Postgres (PGlite, stored in ./.data).
# For production set a real PostgreSQL connection string (Neon / Supabase / your server).
# Tables are created and products seeded automatically on first start.
# DATABASE_URL=postgres://user:password@host:5432/softsnuggle?sslmode=require
DATABASE_URL=

# ── Orders ─────────────────────────────────────────────────
# Owner's WhatsApp number with country code, digits only (91 = India)
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# Business (merchant) UPI ID and the payee name shown to customers
UPI_ID=softsnuggle@okaxis
UPI_PAYEE_NAME=Soft Snuggle

# Shipping rules (₹)
NEXT_PUBLIC_SHIPPING_FLAT=79
NEXT_PUBLIC_FREE_SHIPPING_ABOVE=1499
